# 复制为 .env 后手动填写；进程环境优先，不会由 SDK 自动加载。
MODEL_PROVIDER=anthropic
MODEL_ID=
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=
MODEL_TIMEOUT_SECONDS=60
MODEL_MAX_RETRIES=0
MODEL_MAX_TOKENS=8000

# OpenAI Chat Completions 兼容服务：显式选择模型和地址。
# MODEL_PROVIDER=openai-compatible
# MODEL_ID=your-model
# MODEL_API_KEY=
# MODEL_BASE_URL=https://your-service.example/v1
# 按服务实际支持的额度字段选择；OpenAI 新模型可使用 max_completion_tokens。
# MODEL_TOKEN_PARAMETER=max_completion_tokens
